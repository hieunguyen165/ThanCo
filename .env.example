# ============================================================
# SUPABASE — bắt buộc
# ============================================================
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJ..."        # anon key
SUPABASE_SERVICE_ROLE_KEY="eyJ..."       # service_role key (chỉ server, không expose client)

# VITE_ prefix để inject vào client bundle (build-time)
VITE_SUPABASE_URL="https://xxxx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."
VITE_SUPABASE_PROJECT_ID="xxxx"

# ============================================================
# AI KEY — chọn 1 trong 2
# ============================================================

# Ưu tiên 1: Beeknoee (OpenAI-compatible, hỗ trợ Gemini Flash)
# Lấy tại: https://platform.beeknoee.com
BEEKNOEE_API_KEY="sk-bee-..."

# Ưu tiên 2: Gemini trực tiếp (Google AI Studio)
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIza..."

# ============================================================
# Cloudflare Pages / Workers — cấu hình trong dashboard
# KHÔNG đặt vào file .env, chỉ để tham khảo tên biến
# ============================================================
# Cách set: Cloudflare Dashboard → Pages → Settings → Environment variables
